# Kopieren nach .env und ausfüllen. Die .env wird NICHT eingecheckt (.gitignore).
# -> Welche Keys wo herkommen, steht in README.md / PLAN.md.

# --- Twitch -------------------------------------------------------------
# https://dev.twitch.tv/console/apps  ("Register Your Application")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Data API v3 ------------------------------------------------
# https://console.cloud.google.com/apis  -> "YouTube Data API v3" aktivieren -> API-Key
YOUTUBE_API_KEY=

# --- Anthropic / Claude (Texte & Hashtags) ------------------------------
# https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Zernio (empfohlener Upload-/Planungsweg) ---------------------------
# https://zernio.com/dashboard/api-keys  -> API-Key erstellen (beginnt mit sk_)
# Zernio ist eine von TikTok auditierte App -> KEIN eigenes Content-Posting-Audit nötig.
# TikTok-Konto(en) einmalig unter https://zernio.com verbinden.
ZERNIO_API_KEY=
# Optional (Standard: https://zernio.com/api). Endpunkte liegen unter /v1/...
ZERNIO_BASE_URL=https://zernio.com/api
# Optional: feste Zernio-Konto-IDs statt Auto-Auflösung per @handle.
# IDs anzeigen:  python3 -m src.cli zernio-accounts
# ZERNIO_ACCOUNT_ID_TRYMACS=
# ZERNIO_ACCOUNT_ID_ELIGELLA=
# ZERNIO_ACCOUNT_ID_SIDNEY=

# --- TikTok Content Posting API (Legacy-Direktupload, optional) ----------
# Nur nötig, wenn posting.uploader=tiktok statt zernio genutzt wird.
# https://developers.tiktok.com  -> App anlegen -> Content Posting API beantragen
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Muss EXAKT so auch im Developer Portal unter der App eingetragen sein:
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
# Pro Creator-Account ein OAuth-Token mit Scope video.publish.
# Diese Tokens NICHT von Hand suchen – erzeugen mit:  python3 -m src.cli auth --creator <id>
# Schema: TIKTOK_ACCESS_TOKEN_<CREATOR_ID_GROSS>  (CREATOR_ID = id aus creators.yaml)
TIKTOK_ACCESS_TOKEN_TRYMACS=
TIKTOK_REFRESH_TOKEN_TRYMACS=
TIKTOK_ACCESS_TOKEN_ELIGELLA=
TIKTOK_REFRESH_TOKEN_ELIGELLA=
TIKTOK_ACCESS_TOKEN_SIDNEY=
TIKTOK_REFRESH_TOKEN_SIDNEY=
