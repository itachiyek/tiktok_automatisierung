# Kopieren nach .env und ausfüllen. Die .env wird NICHT eingecheckt (.gitignore).
# -> Welche Keys wo herkommen, steht in README.md / PLAN.md.

# --- Twitch -------------------------------------------------------------
# https://dev.twitch.tv/console/apps  ("Register Your Application")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Data API v3 ------------------------------------------------
# https://console.cloud.google.com/apis  -> "YouTube Data API v3" aktivieren -> API-Key
YOUTUBE_API_KEY=

# --- LLM-Anbieter (Texte & Hashtags) ------------------------------------
# auto = OpenAI bevorzugt (falls Key da), sonst Anthropic. Zum Wechseln:
#   LLM_PROVIDER=openai     -> OpenAI erzwingen
#   LLM_PROVIDER=anthropic  -> Claude erzwingen
LLM_PROVIDER=auto

# --- OpenAI -------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (Alternative) -----------------------------------
# https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- TikTok Content Posting API -----------------------------------------
# https://developers.tiktok.com  -> App anlegen -> Content Posting API beantragen
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Muss EXAKT so auch im Developer Portal unter der App eingetragen sein:
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
# Pro Creator-Account ein OAuth-Token mit Scope video.publish.
# Diese Tokens NICHT von Hand suchen – erzeugen mit:  python3 -m src.cli auth --creator <id>
# Schema: TIKTOK_ACCESS_TOKEN_<CREATOR_ID_GROSS>  (CREATOR_ID = id aus creators.yaml)
TIKTOK_ACCESS_TOKEN_TRYMACS=
TIKTOK_REFRESH_TOKEN_TRYMACS=
TIKTOK_ACCESS_TOKEN_SECONDTRY=
TIKTOK_REFRESH_TOKEN_SECONDTRY=
TIKTOK_ACCESS_TOKEN_ELIASN97=
TIKTOK_REFRESH_TOKEN_ELIASN97=
